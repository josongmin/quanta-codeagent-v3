# quanta PR bot — Tier 0 GitHub Actions integration (ADR-0311 … 0314).
#
# Copy this file to `.github/workflows/quanta.yml` in your repo, then add the
# repo-secrets listed at the bottom. The bot acknowledges `@quanta` (or
# `/quanta`) mentions on PR comments / reviews and opens.
#
# Concurrency: superseded runs are cancelled when a PR force-pushes or the
# same comment is edited again. Timeout: 15min hard cap (belt+braces over
# `from-pr-cmd`'s own per-port time budgets).
#
# Permissions: minimum required to read PR + post a comment. The bot CANNOT
# push commits (no `contents: write`) — code modification is a separate
# workflow you wire intentionally.

name: quanta-pr-bot

on:
  issue_comment:
    types: [created, edited]
  pull_request_review_comment:
    types: [created, edited]
  pull_request_review:
    types: [submitted, edited]
  pull_request:
    types: [opened, synchronize]

# Least-privilege: the Tier-0 path only reads PR metadata + writes a comment.
# `contents: read` covers the checkout; `pull-requests: write` covers
# `gh pr comment` / `gh pr review`. No `contents: write` — the bot CANNOT
# push commits to the repo. `issues: write` is required because
# `issue_comment` is the GH event family used for PR conversation comments
# (a PR comment IS an issue comment under the hood).
permissions:
  contents: read
  pull-requests: write
  issues: write

concurrency:
  # One in-flight run per PR (when triggered by a PR event) or per issue
  # (when an `issue_comment` lands on a real issue — quanta will no-op for
  # those after the cheap pre-filter rejects them, but the group still needs
  # a stable key). `github.run_id` is the last-resort fallback when neither
  # number is present (defensive — should never trigger under the `on:` set
  # above, but keeps the expression total).
  group: >-
    quanta-pr-bot-${{
      github.event.pull_request.number
      || github.event.issue.number
      || github.run_id
    }}
  cancel-in-progress: true

jobs:
  respond:
    name: quanta from-pr
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Cheap pre-filter so non-mention comments do not burn a runner. The
    # in-process mention filter (ADR-0314) is still the authoritative gate.
    # Notes:
    #   - `pull_request` events have no `comment` / `review` object, so the
    #     short-circuit `github.event_name == 'pull_request'` MUST come first
    #     — accessing `.comment.body` on a pull_request payload would
    #     evaluate to `null` (not throw), but ordering by family is clearer.
    #   - `contains()` is case-INSENSITIVE in GH Actions expressions for
    #     ASCII; trigger-phrase customisation that adds non-ASCII tokens
    #     should rely on the in-process mention filter for the real match.
    if: >-
      github.event_name == 'pull_request' ||
      contains(github.event.comment.body, '@quanta') ||
      contains(github.event.comment.body, '/quanta') ||
      contains(github.event.review.body, '@quanta') ||
      contains(github.event.review.body, '/quanta')
    env:
      QUANTA_GH_ACTIONS_TRIGGER: "1"
      # GH_TOKEN gives `gh` permission to read the PR + post a comment under
      # the workflow's `permissions:` block above.
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
      # One of the two must be set; from-pr-cmd surfaces a clear error if
      # the agent loop is ever wired downstream and finds neither.
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
    steps:
      - name: checkout PR head
        # `gh pr view/diff` run server-side, so a shallow checkout is enough
        # for the Tier-0 ack path. fetch-depth 0 is reserved for the future
        # local moved-code detector wiring; flip to 0 when that lands.
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          # Pin to a tag so a runner update can never re-execute the bot
          # against a Bun release that hasn't been smoked. Bump deliberately
          # together with `package.json` engine constraints.
          bun-version: "1.1.38"

      - name: install dependencies (frozen)
        run: bun install --frozen-lockfile

      - name: run quanta from-pr
        # `from-pr` reads GITHUB_EVENT_PATH / GITHUB_EVENT_NAME /
        # GITHUB_REPOSITORY automatically from the runner. The mention
        # filter and trust-scope gate run BEFORE any LLM call.
        #
        # ENTRY-POINT NOTE: this command targets the runner file
        # `src/apps/cli/from-pr-cmd-runner.ts` which composes the production
        # adapters from `from-pr-cmd-adapters.ts` around `runFromPrCmd`.
        # The runner file is the explicit composition root for the Tier-0
        # entry — keeping it separate from `src/apps/cli/index.ts` avoids
        # pulling the full REPL bootstrap (sandbox install, dotenv load,
        # session bootstrap) into a one-shot bot run.
        run: bun run src/apps/cli/from-pr-cmd-runner.ts

      - name: workflow summary
        if: always()
        # `$GITHUB_STEP_SUMMARY` is a markdown sink that surfaces under the
        # workflow run page. We dump the event family + PR number so an
        # operator can see at a glance whether the run was a no-op skip
        # (e.g. bot sender) without scrolling step logs.
        run: |
          {
            echo "## quanta-pr-bot"
            echo ""
            echo "- event: \`${{ github.event_name }}\` (action=\`${{ github.event.action }}\`)"
            echo "- pr: ${{ github.event.pull_request.number || github.event.issue.number || 'n/a' }}"
            echo "- sender: ${{ github.event.sender.login || 'n/a' }}"
            echo "- conclusion: ${{ job.status }}"
            echo ""
            echo "_Mention filter + trust-scope decisions are in the_"
            echo "_\"run quanta from-pr\" step logs (ADR-0314)._"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: report failure to PR (best-effort)
        if: failure()
        run: |
          BODY="quanta encountered an error during PR response. See workflow logs: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          PR_NUM="${{ github.event.pull_request.number || github.event.issue.number }}"
          if [ -n "$PR_NUM" ]; then
            # `|| true` so a 2nd failure here (rate limit, permissions drift)
            # cannot mask the original step's exit code. We do NOT echo
            # `BODY` after the `gh` call — runner logs already show it.
            #
            # Self-loop note: the body above does NOT contain `@quanta` or
            # `/quanta`, so even if GitHub eventually surfaces this comment
            # back through the issue_comment family, the ADR-0314 mention
            # filter would still reject it (and the ADR-0313 idempotency
            # marker stamped by the in-process sink provides a second
            # guard if/when the agent loop is wired downstream).
            gh pr comment "$PR_NUM" --repo "${{ github.repository }}" --body "$BODY" || true
          fi
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

# ─── how to apply ────────────────────────────────────────────────────────
#
#  1. Save this file as `.github/workflows/quanta.yml` in your repo's
#     default branch.
#  2. In your repo settings → Secrets and variables → Actions, add ONE of:
#       - ANTHROPIC_API_KEY   (Claude provider)
#       - OPENAI_API_KEY      (OpenAI provider; quanta picks via env)
#  3. (Optional) Customize trigger phrases or trust scope by adding CLI FLAGS to
#     the `run:` line of the `run quanta from-pr` step — not environment variables:
#       run: bun run src/apps/cli/from-pr-cmd-runner.ts --trigger-phrase "@my-bot"
#       --trust-scope collaborator | member | owner | public
#     (any other scope exits 64).
#     This block used to name QUANTA_GH_TRIGGER_PHRASES and QUANTA_GH_TRUST_SCOPE
#     under `env:`. Nothing has ever read them, so anyone who followed it got the
#     defaults and no error.
#  4. Open a PR and comment `@quanta please review` — the bot will ack
#     within ~30s.
#
# ─── prerequisite ────────────────────────────────────────────────────────
#
# The `run` step targets `src/apps/cli/from-pr-cmd-runner.ts`. Until that
# file lands (see ADR-0311 follow-up: CLI registry option B), the workflow
# template is INSTALL-READY but the `run quanta from-pr` step will exit
# non-zero with `module not found`. The `report failure to PR` step then
# posts a one-line diagnostic comment. To verify the rest of the workflow
# end-to-end before the runner file lands, set `dry-run: true` by passing
# `--dry-run` after the script path (a future revision will surface this
# as a workflow input).

appshot-e-*/
appshot-f-*/
appshot-reach-*/

# Test / coverage — root-anchored so it only matches the project-root test
# output dir, NOT every nested `coverage/`. The anchor-less form silently
# excluded `src/observability/coverage/` (9 production files / ~2700 LOC)
# until R8 audit-closeout caught it.
/coverage/
.nyc_output/

# Cache
.cache/

# Claude Code subagent worktrees (per-agent isolation)
.claude/worktrees/

# Ad-hoc probe/scratch scripts. Ignored so `bun fc check-changed` (which now sees
# the working tree, not just committed history) does not report a throwaway probe
# as an undocumented new feature file.
.scratch/

# Whole-repo scratch COPIES taken to measure something in a quiet tree. One was
# committed on aug-22 (`0cd1e5b84`): 8 238 files / 85 MB / 1.55 M lines of a stale
# twin of every source file, which every clone would pay for and which pollutes
# every index-wide tool. Enforced by tests/unit/_arch/repo-index-hygiene.test.ts.
.pristine-audit/

# Hand-made `git worktree` checkouts of THIS repository. Committing one is not a
# harmless stray file: git records it as a mode-160000 GITLINK, so every movement
# of that worktree's HEAD shows up as a repo diff, and a fresh clone materialises
# an empty directory that no `git submodule update` can fill (nothing declares it
# in .gitmodules). `.worktrees/base` was committed exactly this way on aug-22.
# Enforced by tests/unit/_arch/repo-index-hygiene.test.ts.
.worktrees/

# Extracted Claude desktop corpus binaries (192MB+; not for git)
scripts/_corpus/cc-base/

# SWE-bench smoke live-run artifacts (baseline is picks.jsonl, not these)
tests/smoke/swebench/predictions.jsonl
tests/smoke/swebench/bench-report.json
tests/smoke/swebench/recordings/trajectories/

# R8 audit-closeout — `.js` mirrors of `.ts` sources are bun build artifacts;
# tracking them is the R6 "tier-bypass" hazard (a `.js` import path bypasses
# every R3/R4/R5 fix). Source-of-truth is `.ts` only.
src/observability/coverage/*.js

# python editable-install build artifacts (adapters/terminal-bench)
*.egg-info/

# terminal-bench task download (harbor download terminal-bench) — regenerable, not source
/terminal-bench/

# Local bench/eval scratch + run artifacts (regenerable data, NOT source).
# These were accidentally tracked; large jsonl dumps here bloated history and
# a 113MB bench-trajectory.jsonl blocked pushes (GitHub 100MB cap).
.tmp/
.tmp-tests/
.bench-pull/

# LLM-trajectory recordings (record/replay data + companion meta) — debug/replay
# artifacts, not source. The default sink is <cwd>/bench-trajectory.jsonl.
bench-trajectory*.jsonl
**/trajectories/*.jsonl
**/trajectories/*.meta.json
# Trajectory-viewer baked data bundle (25MB+, generated by launch.ts).
tools/trajectory-viewer/data.js

# Oversized tool-output spill (`src/tool/registry.ts` + `src/agent/loop/compaction-wire.ts`
# both write `<cwd>/.quanta/tool-output/<uuid>.txt`). The spill is the tool's RAW,
# UNREDACTED output — command stdout, file contents, whatever the tool produced —
# so it must never be committed.
#   LIMIT (honest): `spillDir` is rooted at the AGENT'S `ctx.cwd`, i.e. the TARGET
#   repo. This entry therefore only protects the self-hosted case (quanta run on
#   quanta) and any checkout that copies it. It does NOT protect an arbitrary repo
#   the agent is pointed at — that needs a runtime-written ignore or a spill dir
#   outside the workspace, which is a separate design item. Redact-before-spill is
#   likewise out of scope here: `@/tool` may not import `@/agent`'s redaction.
.quanta/tool-output/

# `bun build --compile` scratch. Bun writes `.<hash>-<n>.bun-build` beside the
# CWD while linking and removes it on success — but a worker killed mid-compile
# leaves one behind, and four compiled-binary tests run `bun build` with
# `cwd: REPO_ROOT` because bare specifiers resolve from there. MEASURED: a
# campaign invalidated itself with `checkout changed after chunk 28/44` over two
# of these, and the tree was clean again by the time anyone looked. No test can
# clean it up — bun owns the name and the timing — so ignoring it is the only
# place the fix can live.
.*.bun-build

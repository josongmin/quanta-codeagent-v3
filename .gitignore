# Dependencies
node_modules/

# Reverse-engineering corpus (beautified third-party app code, not for commit)
.extracted_source/

# Build
dist/
*.tsbuildinfo
**/*.js.map

# TypeScript/Bun side-by-side emit (.ts is source of truth)
src/**/*.js
!src/ui/auth-ui.js
tests/**/*.js
tools/**/*.js

# Rust / native addon build
**/target/
*.rlib
*.rmeta
*.node

# Feature-catalog local audit reports (generated by tools/feature-catalog/audit*.ts)
tools/feature-catalog/audit-*-findings.md
tools/feature-catalog/verify-final-findings.md

# Bench / eval run artifacts (local-only; not SSOT)
logs/
runs/
evals/runs/
evals/runs/**/*.meta.json
bench-report*.json
bench-*.json
predictions*.jsonl
gpt-5.*.json
gold.*.json

# Environment (keep examples tracked)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/

# Bun (binary lockfile; commit bun.lock)
bun.lockb

# Test / coverage — root-anchored so it only matches the project-root test
# output dir, NOT every nested `coverage/`. The anchor-less form silently
# excluded `src/observability/coverage/` (9 production files / ~2700 LOC)
# until R8 audit-closeout caught it.
/coverage/
.nyc_output/

# Cache
.cache/

# Claude Code subagent worktrees (per-agent isolation)
.claude/worktrees/

# SWE-bench smoke live-run artifacts (baseline is picks.jsonl, not these)
tests/smoke/swebench/predictions.jsonl
tests/smoke/swebench/bench-report.json
tests/smoke/swebench/recordings/trajectories/

# R8 audit-closeout — `.js` mirrors of `.ts` sources are bun build artifacts;
# tracking them is the R6 "tier-bypass" hazard (a `.js` import path bypasses
# every R3/R4/R5 fix). Source-of-truth is `.ts` only.
src/observability/coverage/*.js

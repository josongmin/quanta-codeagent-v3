{
  "name": "quanta-codeagent",
  "version": "1.0.035",
  "type": "module",
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "build:sdk": "bun build src/sdk/index.ts --outfile dist/sdk/index.js --target node --format esm",
    "build:protocol": "bun run tools/gen-web-frontend-protocol.ts && bun run tools/gen-web-frontend-readout-protocol.ts",
    "build:protocol:check": "bun run tools/gen-web-frontend-protocol.ts --check && bun run tools/gen-web-frontend-readout-protocol.ts --check",
    "build:sdk:types": "bun run tools/dev/build-sdk-types.ts",
    "dev": "bun --hot run src/apps/cli/index.ts",
    "start": "bun run src/apps/cli/index.ts",
    "agent": "bun run src/apps/agent/index.ts",
    "agent:interactive": "bun run src/apps/agent/index.ts --mode interactive",
    "agent:headless": "bun run src/apps/agent/index.ts --mode headless",
    "agent:batch": "bun run src/apps/agent/index.ts --mode batch",
    "agent:ci-bot": "bun run src/apps/agent/index.ts --mode ci-bot",
    "web:daemon": "bun run src/apps/web-daemon/index.ts",
    "test:clean-js": "find tests tools \\( -type d -name '.*' \\) -prune -o -name '*.js' -print0 | xargs -0 rm -f && find src \\( -type d -name '.*' \\) -prune -o -name '*.js' ! -path 'src/ui/auth-ui.js' -print0 | xargs -0 rm -f",
    "test:admission": "bun fc check-changed",
    "test:admission:audit": "bun fc audit",
    "test": "bun run typecheck && bun run test:clean-js && bun run tools/dev/run-test-shards.ts --suite=full",
    "test:unit": "bun run typecheck && bun run test:clean-js && bun run tools/dev/run-test-shards.ts --suite=core",
    "test:unit:ci": "bun run test:clean-js && bun run tools/dev/run-test-shards.ts --suite=unit --junit-out=.cache/unit-junit.xml",
    "test:pollution": "bun run tools/dev/worktree-pollution-guard.ts -- bun test tests/unit",
    "test:cwd-parity": "bun run tools/dev/cwd-parity-check.ts",
    "test:sandbox": "bun run tools/dev/sandboxed-test.ts --parallel=1",
    "verify:scope": "bun run tools/dev/verify-scope.ts",
    "test:fast": "bun run typecheck && bun run test:clean-js && bun test tests/unit/agent tests/unit/llm tests/unit/permission tests/unit/runtime --parallel=1",
    "test:integration": "bun run test:clean-js && bun run tools/dev/run-test-shards.ts --suite=integration",
    "test:resilient": "bun run test:clean-js && bun run tools/test-resilience/cli.ts run tests/unit tests/integration",
    "test:resilient:quarantine": "bun run tools/test-resilience/cli.ts quarantine-check",
    "test:shard": "bun run test:clean-js && bun test tests/unit tests/meta tests/adversarial tests/measurement tests/integration ./src/ ./tools/ --timeout=60000 --parallel=1 --shard=\"${SHARD:-1/1}\"",
    "test:real-toolchain": "mkdir -p .cache/capability && QUANTA_REAL_TOOLCHAIN_E2E=1 bun test $(find tests/unit -name '*-real-e2e.test.ts') --parallel=1 --reporter=junit --reporter-outfile=.cache/capability/toolchain-junit.xml",
    "test:contract": "mkdir -p .cache/capability && bun run test:clean-js && bun test tests/contract --parallel=1 --reporter=junit --reporter-outfile=.cache/capability/contract-junit.xml",
    "test:ci": "bun run prepush",
    "test:resource-certification:audit": "bun run tools/dev/test-resource-certification-audit.ts",
    "test:full:ci": "bun run test:clean-js && bun run tools/dev/run-test-shards.ts --suite=full --junit-out=.cache/full-junit.xml",
    "test:cov": "bun run typecheck && bun run test:clean-js && bun test --coverage tests/unit tests/integration --parallel=1",
    "test:eval": "bun run src/apps/bench/index.ts",
    "capability:pty": "bun run tools/dev/capability-result.ts --producer=pty --junit=.cache/capability/pty-junit.xml --out=.cache/capability/pty.json",
    "capability:toolchain": "bun run tools/dev/capability-result.ts --producer=toolchain --junit=.cache/capability/toolchain-junit.xml --out=.cache/capability/toolchain.json",
    "capability:contract": "bun run tools/dev/capability-result.ts --producer=contract --junit=.cache/capability/contract-junit.xml --out=.cache/capability/contract.json",
    "e2e:pty": "mkdir -p .cache/capability && bun test tests/e2e-pty --reporter=junit --reporter-outfile=.cache/capability/pty-junit.xml",
    "test:web-frontend": "cd apps/web-frontend && ([ -x ./node_modules/.bin/vitest ] || bun install --frozen-lockfile) && ./node_modules/.bin/vitest run",
    "test:watch": "bun run test:clean-js && bun test --watch tests/unit --parallel=1",
    "smoke": "bun run tests/smoke/index.ts",
    "smoke:goal": "bun test tests/smoke/goal --parallel=1",
    "smoke:live": "bun run tests/smoke/index.ts --tier=live",
    "smoke:report": "bun run tests/smoke/index.ts --report",
    "smoke:record": "bun run tests/smoke/record-cli.ts",
    "smoke:swebench": "bun run src/apps/bench/index.ts --swebench tests/smoke/swebench/picks.jsonl --predictions tests/smoke/swebench/predictions.jsonl --report tests/smoke/swebench/bench-report.json",
    "smoke:swebench:audit": "bun run tests/smoke/swebench/select.ts --audit",
    "smoke:preset-eval": "QUANTA_BENCH_PRESET=${QUANTA_BENCH_PRESET:-agentless-v6-singlepass-execfull} bun run src/apps/bench/index.ts --swebench tests/smoke/swebench/preset-eval-smoke.jsonl --predictions tests/smoke/swebench/preset-eval-preds.jsonl --report tests/smoke/swebench/preset-eval-report.json",
    "hooks:install": "git config core.hooksPath .githooks && echo 'core.hooksPath = .githooks (pre-commit active)'",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "precommit": "bun run tools/dev/gate.ts precommit",
    "prepush": "bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts prepush --reuse-receipt --bail",
    "prepush:cold": "QUANTA_TEST_CACHE=off bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts prepush --bail",
    "test:smoke-canary": "bun test tests/unit/smoke-battery.test.ts tests/unit/git/conflict-parser-differential-fuzz.canary.test.ts --parallel=1",
    "verify:smoke": "bun run tools/dev/gate.ts smoke",
    "verify:prepush": "bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts prepush",
    "verify:pr": "bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts pr --keep-going",
    "verify:full": "bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts full --keep-going",
    "verify:nightly": "QUANTA_TEST_CACHE=off bun run tools/dev/verification-campaign.ts -- bun run tools/dev/gate.ts nightly --keep-going",
    "gates:list": "bun run tools/dev/gate.ts --list",
    "typecheck": "bun run tools/dev/typecheck.ts src",
    "typecheck:tests": "bun run tools/dev/typecheck.ts tests",
    "typecheck:all": "bun run tools/dev/typecheck.ts all",
    "lint": "bun run tools/dev/run-biome.ts check",
    "lint:fix": "bun run tools/dev/run-biome.ts check --write",
    "lint:debt": "bun run tools/dev/lint-debt-ceiling.ts",
    "audit:merge-symbol-loss": "bun run tools/dev/merge-symbol-loss.ts",
    "mutation-check": "bun run tools/dev/mutation-check.ts",
    "format": "bun run tools/dev/run-biome.ts format --write",
    "build": "bun build --compile --minify src/apps/cli/index.ts --outfile dist/agent",
    "install:cli": "bash tools/bin/install-quanta-cli.sh",
    "baseline:silent-catch": "bun run tools/dev/refresh-silent-catch-baseline.ts",
    "bench": "bun run src/apps/bench/cli.ts",
    "bench:tb": "bun run src/apps/bench/cli.ts terminal",
    "bench:tb:doctor": "bun run src/apps/bench/cli.ts terminal doctor",
    "bench:tb:canary": "bun run src/apps/bench/cli.ts terminal canary",
    "probe": "bun run src/apps/probe/index.ts",
    "bench:verified": "bun run src/apps/bench/index.ts --swebench /Users/songmin/Documents/code-new/quanta-benchmark-corpus/external/swebench/verified/raw/instances.jsonl",
    "fc": "bun run tools/feature-catalog/cli.ts",
    "pm": "bun run tools/pm/check.ts",
    "pm:all": "bun run tools/pm/check.ts --all",
    "pm:all:strict": "bun run tools/pm/check.ts --all --strict",
    "pm:gate": "bun test tests/unit/pm-dod-ratchet.test.ts",
    "eval": "bun run src/apps/eval/entry.ts",
    "eval:audit": "bun run src/apps/eval/entry.ts audit",
    "eval:synthetic": "bun run src/apps/eval/entry.ts synthetic",
    "eval:grounding": "bun run src/apps/eval/entry.ts grounding",
    "eval:trajectory": "bun run src/apps/eval/entry.ts trajectory",
    "eval:replay": "bun run src/apps/eval/entry.ts trajectory replay",
    "eval:compare": "bun run src/apps/eval/entry.ts compare",
    "eval:generate": "bun run src/apps/eval/entry.ts generate",
    "eval:report": "bun run src/apps/eval/entry.ts report",
    "install:terminal-brain": "bash tools/bin/install-terminal-brain.sh",
    "eval:retrieval": "bun run test:clean-js && bun test tests/eval",
    "test:cwd-parity:arch": "bun run tools/dev/cwd-parity-check.ts tests/unit/_arch tests/meta",
    "test:non-vacuity": "bun run tools/dev/empty-mirror-check.ts",
    "scan-reach": "bun run tools/dev/scan-reach-baseline.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.29.2",
    "@anthropic-ai/foundry-sdk": "0.2.3",
    "@anthropic-ai/sdk": "^0.40.0",
    "@anthropic-ai/vertex-sdk": "0.16.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@secretlint/core": "13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@secretlint/types": "13.0.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "csv-parse": "6.2.1",
    "openai": "^6.38.0",
    "quickjs-emscripten": "0.32.0",
    "turndown": "7.2.4",
    "web-tree-sitter": "0.26.9",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/react": "18.3.29",
    "bun-types": "^1.1.0",
    "execa": "9.6.1",
    "is-path-inside": "4.0.0",
    "p-retry": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.0"
  }
}

                  "@/mcp": "Slice isolation (RFC 3.1): @/mcp is reachable only via @/agent",
                  "@/tool": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/memory": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/storage": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/stream": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/permission": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/runtime": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/observability": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only",
                  "@/llm": "Slice isolation (RFC 3.1): @/lsp depends on @/shared only"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/mcp": "Slice isolation (RFC 3.1): @/mcp is reachable only via @/agent",
                  "@/tool": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/memory": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/storage": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/stream": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/permission": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/runtime": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/lsp": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/observability": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only",
                  "@/llm": "Slice isolation (RFC 3.1): @/mcp depends on @/shared only"

      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/mcp": "Slice isolation (RFC 3.1): @/mcp is reachable only via @/agent",
                  "@/tool": "Slice isolation (RFC 3.1): @/observability depends on @/shared only",
                  "@/memory": "Slice isolation (RFC 3.1): @/observability depends on @/shared only",
                  "@/storage": "Slice isolation (RFC 3.1): @/observability depends on @/shared only",

            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/mcp": "Slice isolation (RFC 3.1): @/mcp is reachable only via @/agent",
                  "@/tool": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",
                  "@/memory": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",
                  "@/storage": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",
                  "@/stream": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",
                  "@/runtime": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",
                  "@/lsp": "Slice isolation (RFC 3.1): @/permission depends on @/shared only",

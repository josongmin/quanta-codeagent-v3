{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outFile": "dist/sdk/quanta-sdk-modules.js",
    "module": "system",
    "moduleResolution": "node10",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/host/bootstrap": ["./dist/sdk/stage/host/bootstrap/index"],
      "@/host/*": ["./dist/sdk/stage/host/*"],
      "@/protocol/*": ["./dist/sdk/stage/protocol/*"],
      "@/kernel/*": ["./dist/sdk/stage/kernel/*"],
      "@/apps/*": ["./dist/sdk/stage/apps/*"],
      "@/*": ["./dist/sdk/stage/*"]
    }
  },
  "include": ["dist/sdk/stage/sdk/index.ts", "dist/sdk/stage/__ambient__/*.ts"]
}

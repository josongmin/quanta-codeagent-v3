# Belt-and-braces — root .gitignore covers these too, but keep them
# explicit here so the package is portable on its own.
node_modules/
dist/
*.tsbuildinfo
.vite/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Emitted JS must never live in src (it shadows .ts at vite resolve: .js > .ts).
# All frontend source is .ts/.tsx; build output goes to dist/.
src/**/*.js
src/**/*.js.map

{
  "extends": "./tsconfig.base.json",
  "include": [
    "tests",
    "src/**/*.d.ts",
    "tools/**/*.d.ts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.test.ts",

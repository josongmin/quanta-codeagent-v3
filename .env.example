# Copy to .env.dev (gitignored) and fill in. CLI loads .env.dev → .env.local → .env
# (first value wins; real environment overrides files).

# --- LLM provider (one key is enough) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # optional, for OpenAI-compatible gateways

# --- Behaviour ---
# QUANTA_PROVIDER=openai      # anthropic | openai (default: inferred from keys)
# QUANTA_MODEL=gpt-4o         # default: claude-sonnet-4-6 (anthropic) / gpt-4o (openai)
# QUANTA_MAX_TURNS=40
# QUANTA_PERMISSION=acceptEdits   # default | acceptEdits | bypass | auto
# QUANTA_LOG_LEVEL=info       # debug | info | warn | error

# --- SOTA++ absorption (all default OFF / behavior-preserving) ---
# QUANTA_SUBAGENT=1               # enable Agent/Task/TaskOutput/TaskStop tools
# QUANTA_SUBAGENT_MAX_DEPTH=2     # recursion-depth cap (needs QUANTA_SUBAGENT)
# QUANTA_SKILLS_DIR=./skills      # enable skill discovery + Skill/ToolSearch tools
# QUANTA_PERMISSION=auto          # LLM-classifier auto allow/deny (uses final llm)
# QUANTA_MODEL_FALLBACK=claude-haiku-4-6   # comma-list of fallback model ids
# QUANTA_COMPACT_BREAKER=off      # opt OUT of the compaction circuit breaker
# QUANTA_COMPACT_BREAKER_REACTIVE_MAX=3    # override caps.maxConsecutiveReactive
# QUANTA_COMPACT_BREAKER_PROACTIVE_MAX=3   # override caps.maxNoProgressProactive

# --- Eval / SWE-bench (repo-external path recommended) ---
# QUANTA_SWEBENCH_CORPUS_ROOT=/path/to/quanta-benchmark-corpus

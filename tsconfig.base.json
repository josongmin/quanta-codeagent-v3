      "@/connectors": ["./src/connectors/index.ts"],
      "@/connectors/*": ["./src/connectors/*"],
      "@/retrieval": ["./src/retrieval/index.ts"],
      "@/retrieval/*": ["./src/retrieval/*"],
      "@/media": ["./src/media/index.ts"],
      "@/media/*": ["./src/media/*"],
      "@/voice": ["./src/voice/index.ts"],
      "@/voice/*": ["./src/voice/*"],
      "@/browser": ["./src/browser/index.ts"],
      "@/browser/*": ["./src/browser/*"],
      "@/realtime": ["./src/realtime/index.ts"],
      "@/realtime/*": ["./src/realtime/*"],
      "@/radar": ["./src/radar/index.ts"],
      "@/radar/*": ["./src/radar/*"],
      "@/remote": ["./src/remote/index.ts"],
      "@/remote/*": ["./src/remote/*"],
      "@/apps/cli": ["./src/apps/cli/index.ts"],
      "@/apps/cli/*": ["./src/apps/cli/*"],
      "@surfaces/vscode/*": ["./surfaces/vscode/src/*"]
    }
  }
}

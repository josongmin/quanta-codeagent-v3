      "@/kernel/*": ["./src/kernel/*"],
      "@/sdk": ["./src/sdk/index.ts"],
      "@/sdk/*": ["./src/sdk/*"],
      "@/ipc": ["./src/ipc/index.ts"],
      "@/ipc/*": ["./src/ipc/*"],
      "@/git": ["./src/git/index.ts"],
      "@/git/*": ["./src/git/*"],
      "@/reactor": ["./src/reactor/index.ts"],
      "@/reactor/*": ["./src/reactor/*"],
      "@/integrations/github": ["./src/integrations/github/index.ts"],
      "@/integrations/github/*": ["./src/integrations/github/*"],
      "@/plugin-isolation": ["./src/plugin-isolation/index.ts"],
      "@/plugin-isolation/*": ["./src/plugin-isolation/*"],
      "@/scheduler": ["./src/scheduler/index.ts"],
      "@/scheduler/*": ["./src/scheduler/*"],
      "@/workflow": ["./src/workflow/index.ts"],
      "@/workflow/*": ["./src/workflow/*"],
      "@/side-agent": ["./src/side-agent/index.ts"],

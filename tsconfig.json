{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "lib": ["ESNext"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "allowJs": false,

    "baseUrl": ".",
    "paths": {
      "@/shared": ["./src/shared/index.ts"],
      "@/shared/*": ["./src/shared/*"],
      "@/llm": ["./src/llm/index.ts"],
      "@/llm/*": ["./src/llm/*"],
      "@/tool": ["./src/tool/index.ts"],
      "@/tool/*": ["./src/tool/*"],
      "@/memory": ["./src/memory/index.ts"],
      "@/memory/*": ["./src/memory/*"],
      "@/storage": ["./src/storage/index.ts"],
      "@/storage/*": ["./src/storage/*"],
      "@/stream": ["./src/stream/index.ts"],
      "@/stream/*": ["./src/stream/*"],
      "@/permission": ["./src/permission/index.ts"],
      "@/permission/*": ["./src/permission/*"],
      "@/runtime": ["./src/runtime/index.ts"],
      "@/runtime/*": ["./src/runtime/*"],
      "@/lsp": ["./src/lsp/index.ts"],
      "@/lsp/*": ["./src/lsp/*"],
      "@/mcp": ["./src/mcp/index.ts"],
      "@/mcp/*": ["./src/mcp/*"],
      "@/observability": ["./src/observability/index.ts"],
      "@/observability/*": ["./src/observability/*"],
      "@/subagent": ["./src/subagent/index.ts"],
      "@/subagent/*": ["./src/subagent/*"],
      "@/skill": ["./src/skill/index.ts"],
      "@/skill/*": ["./src/skill/*"],
      "@/session": ["./src/session/index.ts"],
      "@/session/*": ["./src/session/*"],
      "@/agent": ["./src/agent/index.ts"],
      "@/agent/*": ["./src/agent/*"],
      "@/rules": ["./src/rules/index.ts"],
      "@/rules/*": ["./src/rules/*"],
      "@/migration": ["./src/migration/index.ts"],
      "@/migration/*": ["./src/migration/*"],
      "@/patch": ["./src/patch/index.ts"],
      "@/patch/*": ["./src/patch/*"],
      "@/security": ["./src/security/index.ts"],
      "@/security/*": ["./src/security/*"],
      "@/auth": ["./src/auth/index.ts"],
      "@/auth/*": ["./src/auth/*"],
      "@/ui": ["./src/ui/index.ts"],
      "@/ui/*": ["./src/ui/*"],
      "@/runner": ["./src/runner/index.ts"],
      "@/runner/*": ["./src/runner/*"],
      "@/ipc": ["./src/ipc/index.ts"],
      "@/ipc/*": ["./src/ipc/*"],
      "@/git": ["./src/git/index.ts"],
      "@/git/*": ["./src/git/*"],
      "@/reactor": ["./src/reactor/index.ts"],
      "@/reactor/*": ["./src/reactor/*"],
      "@/connectors": ["./src/connectors/index.ts"],
      "@/connectors/*": ["./src/connectors/*"]
    }
  },
  "include": ["src", "tests", "tools"],
  "exclude": ["node_modules", "dist", "tests/smoke/fixtures"]
}

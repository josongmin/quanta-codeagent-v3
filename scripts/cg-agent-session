#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  scripts/cg-agent-session
  scripts/cg-agent-session --exec -- <command> [args...]

Reports repo/session facts for agent bootstrap. With `--exec --`, prints the
same facts and then runs the given command from the repo root.
EOF
}

EXEC_MODE=false
EXEC_ARGS=()

if [[ $# -gt 0 ]]; then
  case "${1}" in
    --help|-h)
      usage
      exit 0
      ;;
    --exec)
      EXEC_MODE=true
      shift
      if [[ $# -eq 0 || "${1}" != "--" ]]; then
        usage >&2
        exit 2
      fi
      shift
      if [[ $# -eq 0 ]]; then
        usage >&2
        exit 2
      fi
      EXEC_ARGS=("$@")
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
fi

if [[ ! -d "${REPO_ROOT}/.git" ]]; then
  echo "error: ${REPO_ROOT} is not a git repository" >&2
  exit 1
fi

branch="$(git -C "${REPO_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo detached)"
head_sha="$(git -C "${REPO_ROOT}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
status_lines="$(git -C "${REPO_ROOT}" status --short --untracked-files=all)"

if [[ -n "${status_lines}" ]]; then
  dirty_worktree=true
  modified_count="$(printf '%s\n' "${status_lines}" | sed '/^$/d' | wc -l | tr -d ' ')"
else
  dirty_worktree=false
  modified_count=0
fi

untracked_count="$(printf '%s\n' "${status_lines}" | awk 'BEGIN{n=0} /^\?\? / {n++} END{print n}')"

echo "repo_root=${REPO_ROOT}"
echo "git_branch=${branch}"
echo "git_head=${head_sha}"
echo "dirty_worktree=${dirty_worktree}"
echo "tracked_or_untracked_rows=${modified_count}"
echo "untracked_rows=${untracked_count}"

if [[ "${EXEC_MODE}" == true ]]; then
  (
    cd "${REPO_ROOT}"
    "${EXEC_ARGS[@]}"
  )
fi

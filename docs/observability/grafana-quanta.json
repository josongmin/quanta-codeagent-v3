{
  "annotations": { "list": [] },
  "description": "quanta agent monitoring dashboard (ADR-0158/0159). 24 panels covering LLM provider / OS sandbox / LSP / subagent / shadow ODB / conversation / budget / plan-queue / tools / session.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "schemaVersion": 38,
  "tags": ["quanta", "agent", "otel"],
  "templating": {
    "list": [
      { "name": "provider", "type": "query", "datasource": "Prometheus", "query": "label_values(llm_provider_stream_total, provider)", "multi": true, "includeAll": true },
      { "name": "model", "type": "query", "datasource": "Prometheus", "query": "label_values(llm_provider_stream_total{provider=~\"$provider\"}, model)", "multi": true, "includeAll": true }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "quanta / agent overview",
  "uid": "quanta-agent-overview",
  "version": 1,
  "panels": [
    { "id": 1,  "type": "stat",       "title": "LLM stream calls (5m)",   "gridPos": { "x": 0,  "y": 0,  "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(llm_provider_stream_total{provider=~\"$provider\",model=~\"$model\"}[5m]))" }] },
    { "id": 2,  "type": "stat",       "title": "LLM failures (5m)",       "gridPos": { "x": 6,  "y": 0,  "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(llm_provider_stream_failures_total{provider=~\"$provider\"}[5m]))" }] },
    { "id": 3,  "type": "timeseries", "title": "LLM TTFT p95 (ms)",        "gridPos": { "x": 12, "y": 0,  "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by(le,provider)(rate(llm_provider_stream_ttft_ms_bucket{provider=~\"$provider\"}[5m])))" }] },
    { "id": 4,  "type": "timeseries", "title": "LLM duration p95 (ms)",    "gridPos": { "x": 0,  "y": 4,  "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by(le,provider,stop_reason)(rate(llm_provider_stream_duration_ms_bucket[5m])))" }] },
    { "id": 5,  "type": "stat",       "title": "Sandbox spawn (5m)",       "gridPos": { "x": 0,  "y": 12, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(sandbox_spawn_total[5m]))" }] },
    { "id": 6,  "type": "stat",       "title": "Sandbox degraded (5m)",    "gridPos": { "x": 6,  "y": 12, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(sandbox_spawn_degraded_total[5m]))" }] },
    { "id": 7,  "type": "piechart",   "title": "Sandbox backend mix",      "gridPos": { "x": 12, "y": 12, "w": 6,  "h": 8 }, "targets": [{ "expr": "sum by(backend)(rate(sandbox_spawn_total[10m]))" }] },
    { "id": 8,  "type": "stat",       "title": "LSP requests (5m)",        "gridPos": { "x": 18, "y": 12, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(lsp_request_total[5m]))" }] },
    { "id": 9,  "type": "timeseries", "title": "LSP duration p95 (ms)",    "gridPos": { "x": 0,  "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by(le,method)(rate(lsp_request_ms_bucket[5m])))" }] },
    { "id": 10, "type": "stat",       "title": "LSP EXDEV fallbacks",      "gridPos": { "x": 12, "y": 16, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(increase(lsp_workspace_edit_exdev_total[1h]))" }] },
    { "id": 11, "type": "stat",       "title": "Subagent forks (5m)",      "gridPos": { "x": 18, "y": 16, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(subagent_fork_total[5m]))" }] },
    { "id": 12, "type": "timeseries", "title": "Subagent duration p95 by status", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by(le,status)(rate(subagent_duration_ms_bucket[5m])))" }] },
    { "id": 13, "type": "stat",       "title": "Subagent cancels (5m)",    "gridPos": { "x": 0,  "y": 24, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(subagent_cancel_total[5m]))" }] },
    { "id": 14, "type": "stat",       "title": "Subagent persist restored","gridPos": { "x": 6,  "y": 24, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(increase(subagent_hydrate_restored_total[1h]))" }] },
    { "id": 15, "type": "stat",       "title": "Shadow checkpoints (5m)",  "gridPos": { "x": 0,  "y": 28, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(shadow_checkpoint_total[5m]))" }] },
    { "id": 16, "type": "stat",       "title": "Shadow rewinds (1h)",      "gridPos": { "x": 6,  "y": 28, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(increase(shadow_rewind_total[1h]))" }] },
    { "id": 17, "type": "stat",       "title": "Conversation checkpoints (5m)", "gridPos": { "x": 12, "y": 28, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(conversation_checkpoint_total[5m]))" }] },
    { "id": 18, "type": "stat",       "title": "Budget breaches (1h)",     "gridPos": { "x": 18, "y": 28, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(increase(budget_breach_total[1h]))" }] },
    { "id": 19, "type": "table",      "title": "Budget breach detail",     "gridPos": { "x": 0,  "y": 32, "w": 12, "h": 6 }, "targets": [{ "expr": "sum by(kind,scope)(increase(budget_breach_total[24h]))" }] },
    { "id": 20, "type": "stat",       "title": "Plan-queue enqueues (5m)", "gridPos": { "x": 12, "y": 32, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(plan_queue_enqueue_total[5m]))" }] },
    { "id": 21, "type": "stat",       "title": "Web fetches (5m)",         "gridPos": { "x": 18, "y": 32, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(web_fetch_total[5m]))" }] },
    { "id": 22, "type": "stat",       "title": "Web search (5m)",          "gridPos": { "x": 0,  "y": 38, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(web_search_total[5m]))" }] },
    { "id": 23, "type": "stat",       "title": "Image reads (5m)",         "gridPos": { "x": 6,  "y": 38, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(read_image_total[5m]))" }] },
    { "id": 24, "type": "stat",       "title": "PDF reads (5m)",           "gridPos": { "x": 12, "y": 38, "w": 6,  "h": 4 }, "targets": [{ "expr": "sum(rate(pdf_read_total[5m]))" }] }
  ]
}
